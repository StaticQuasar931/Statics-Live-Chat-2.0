{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "publicUsers": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "dms": {
      "$dmId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "dmMessages": {
      "$dmId": {
        "$messageId": {
          ".read": "auth != null",
          ".write": "auth != null && newData.child('authorId').val() === auth.uid",
          ".validate": "newData.exists() && newData.hasChildren(['authorId','content','createdAt'])"
        }
      }
    },

    "groupDms": {
      "$groupId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "groupDmMessages": {
      "$groupId": {
        "$messageId": {
          ".read": "auth != null",
          ".write": "auth != null && newData.child('authorId').val() === auth.uid",
          ".validate": "newData.exists() && newData.hasChildren(['authorId','content','createdAt'])"
        }
      }
    },

    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "typing": {
      "$scopeType": {
        "$scopeId": {
          "$uid": {
            ".read": "auth != null",
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },

    "reports": {
      "$reportId": {
        ".read": "auth != null && root.child('admins/' + auth.uid).val() === true",
        ".write": "auth != null",
        ".validate": "newData.exists() && newData.hasChildren(['createdBy','createdAt','type','details']) && newData.child('createdBy').val() === auth.uid"
      }
    },

    "admins": {
      "$uid": {
        ".read": "auth != null && root.child('admins/' + auth.uid).val() === true",
        ".write": "false"
      }
    }
  }
}
