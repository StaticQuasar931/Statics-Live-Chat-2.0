{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        "friendRequestsIn": {
          "$fromUid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && (auth.uid === $uid || auth.uid === $fromUid)",
            ".validate": "newData.hasChildren(['fromUid','createdAt']) || !newData.exists()"
          }
        },
        "friendRequestsOut": {
          "$toUid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['toUid','createdAt']) || !newData.exists()"
          }
        },
        "friends": {
          "$friendUid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['uid','displayNameDisplay','since']) || !newData.exists()"
          }
        },
        "chatRefs": {
          "$refId": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.exists() || !newData.exists()"
          }
        },
        "chatState": {
          "$refId": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.exists() || !newData.exists()"
          }
        },
        "blocks": {
          "$blockedUid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.val() === true || !newData.exists()"
          }
        },
        "settings": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        },
        "nameHistory": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "publicUsers": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.exists()"
      }
    },

    "displayNames": {
      ".read": "auth != null",
      "$normalized": {
        ".write": "auth != null && ((newData.exists() && newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid)) || (!newData.exists() && data.val() === auth.uid))",
        ".validate": "newData.val() === auth.uid || !newData.exists()"
      }
    },

    "dms": {
      "$dmId": {
        ".read": "auth != null && data.child('memberIds/' + auth.uid).val() === true",
        ".write": "auth != null && ((!data.exists() && newData.child('memberIds/' + auth.uid).val() === true) || (data.exists() && data.child('memberIds/' + auth.uid).val() === true))",
        ".validate": "newData.exists() && newData.child('memberIds').hasChildren()"
      }
    },

    "dmMessages": {
      "$dmId": {
        "$messageId": {
          ".read": "auth != null && root.child('dms/' + $dmId + '/memberIds/' + auth.uid).val() === true",
          ".write": "auth != null && root.child('dms/' + $dmId + '/memberIds/' + auth.uid).val() === true && newData.child('authorId').val() === auth.uid",
          ".validate": "newData.hasChildren(['authorId','content','createdAt']) && newData.child('content').isString() && newData.child('content').val().length <= 4000 && newData.child('createdAt').isNumber()",

          "reactions": {
            "$emoji": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('dms/' + $dmId + '/memberIds/' + auth.uid).val() === true",
                ".validate": "newData.val() === true || !newData.exists()"
              }
            }
          }
        }
      }
    },

    "groupDms": {
      "$groupId": {
        ".read": "auth != null && (data.child('memberIds/' + auth.uid).val() === true || (query.orderByChild === 'code' && query.equalTo === data.child('code').val()))",
        ".write": "auth != null && ((!data.exists() && newData.child('memberIds/' + auth.uid).val() === true) || (data.exists() && data.child('memberIds/' + auth.uid).val() === true))",
        ".validate": "newData.exists() && newData.child('memberIds').hasChildren()"
      }
    },

    "groupDmMessages": {
      "$groupId": {
        "$messageId": {
          ".read": "auth != null && root.child('groupDms/' + $groupId + '/memberIds/' + auth.uid).val() === true",
          ".write": "auth != null && root.child('groupDms/' + $groupId + '/memberIds/' + auth.uid).val() === true && newData.child('authorId').val() === auth.uid",
          ".validate": "newData.hasChildren(['authorId','content','createdAt']) && newData.child('content').isString() && newData.child('content').val().length <= 4000 && newData.child('createdAt').isNumber()",

          "reactions": {
            "$emoji": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('groupDms/' + $groupId + '/memberIds/' + auth.uid).val() === true",
                ".validate": "newData.val() === true || !newData.exists()"
              }
            }
          }
        }
      }
    },

    "typing": {
      "$scopeType": {
        "$scopeId": {
          "$uid": {
            ".read": "auth != null",
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },

    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "reports": {
      "$reportId": {
        ".read": "auth != null && root.child('admins/' + auth.uid).val() === true",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['createdBy','createdAt','type','details']) && newData.child('createdBy').val() === auth.uid"
      }
    },

    "admins": {
      "$uid": {
        ".read": "auth != null && root.child('admins/' + auth.uid).val() === true",
        ".write": "false"
      }
    }
  }
}
